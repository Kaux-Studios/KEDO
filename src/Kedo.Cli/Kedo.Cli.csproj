<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kedo.Cli</RootNamespace>
    <AssemblyName>kedo</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kedo</ToolCommandName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>KEDO command line: parse, check, fmt, build, schema, explain, mcp.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Kedo.Core/Kedo.Core.csproj" />
    <ProjectReference Include="../Kedo.Compiler/Kedo.Compiler.csproj" />
  </ItemGroup>
</Project>
