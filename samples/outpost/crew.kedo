kedo 1
module outpost

abstract crew person { mood = calm  skill = 2  portrait = asset:portrait_default }

crew ada extends person { name = "Ada"  role = engineer  skill = 4  home = room:workshop }
crew bo extends person { name = "Bo"  role = botanist  skill = 3  home = room:greenhouse }
crew cy extends person { name = "Cy"  role = medic  home = room:habitat_a }
crew dee extends person { name = "Dee"  role = child  skill = 1  mood = tense  home = room:habitat_a }

asset portrait_default { path = "art/portrait.png" }

/// Costo de reparación según la integridad perdida (puntos básicos de partes).
function repair_cost(integrity: int, parts: int) -> int {
    if (integrity >= 80) { return parts }
    if (integrity >= 40) { return parts * 2 }
    return parts * 4
}
